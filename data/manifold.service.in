[Unit]
Description=Manifold Manager
Requires=manifold.socket

[Service]
Type=notify
ExecStart=@MF_LIBEXECDIR@/manifoldd
StateDirectory=manifold
StateDirectoryMode=0755

LockPersonality=yes
RestrictRealtime=yes
ProtectHome=yes

[Install]
Also=manifold.socket
