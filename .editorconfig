# See https://editorconfig.org/
root = true

[*]
end_of_line = lf
trim_trailing_whitespace = true
charset = utf-8
max_line_length = 100

[*.{c,h}]
indent_style = space
indent_size = 4

[*.sh]
indent_style = space
indent_size = 4

[meson.build]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2
